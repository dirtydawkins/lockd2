# Render service environment only. Never put service-role keys in Vercel public config or the browser.
INTELLIGENCE_SHARED_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly deferred. Production mode is refused by the current adapter.
PERSONA_ENABLED=false
PERSONA_ENVIRONMENT=sandbox
PERSONA_API_KEY=
PERSONA_ENVIRONMENT_ID=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
PERSONA_PREVIOUS_WEBHOOK_SECRET=
# Choose an approved validity period before enabling sandbox reconciliation (1..365).
PERSONA_PASSPORT_VALID_DAYS=

# Private document worker. Keep off until scanner, approved retention, processor/license
# review, service connection and measured Render resource limits are ready.
DOCUMENT_PROCESSING_ENABLED=false
DOCUMENT_OCR_ENABLED=false
# Local ClamD Unix socket. An absent/unhealthy scanner never counts as clean.
DOCUMENT_CLAMD_SOCKET=
