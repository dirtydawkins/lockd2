# Render service environment only. Never put service-role keys in Vercel public config or the browser.
INTELLIGENCE_SHARED_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Explicitly deferred. Production mode is refused by the current adapter.
PERSONA_ENABLED=false
PERSONA_ENVIRONMENT=sandbox
PERSONA_API_KEY=
PERSONA_ENVIRONMENT_ID=
PERSONA_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=
PERSONA_PREVIOUS_WEBHOOK_SECRET=
# Choose an approved validity period before enabling sandbox reconciliation (1..365).
PERSONA_PASSPORT_VALID_DAYS=

# Private document worker. Keep off until scanner, approved retention, processor/license
# review, service connection and measured Render resource limits are ready.
DOCUMENT_PROCESSING_ENABLED=false
DOCUMENT_OCR_ENABLED=false
# Local ClamD Unix socket. An absent/unhealthy scanner never counts as clean.
DOCUMENT_CLAMD_SOCKET=

# Sandbox only. Obtain provider-approved test IDs and rental-purpose authorization.
# No production origin is accepted. Keep off until the authorized account is configured.
PELEZA_ENABLED=false
PELEZA_ENVIRONMENT=sandbox
PELEZA_PURPOSE_APPROVED=false
PELEZA_CLIENT_ID=
PELEZA_CLIENT_SECRET=
PELEZA_APPROVED_SANDBOX_IDS=

# Consumer credentials from the user's actual LOCKD Sandbox app. Never live mode.
# This enables private authorization checking only, not customer payment collection.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Test secret only, stored in Render. No public key or customer details are needed
# for the read-only authorization check. Live keys are refused.
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
# Keep false until migration 0024, an approved real test participant/booking and
# Paystack's test webhook have been configured. Does not enable customer checkout.
PAYSTACK_TEST_RECONCILIATION_ENABLED=false
