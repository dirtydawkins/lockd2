# Public Supabase project URL and publishable key. A legacy anon key is also accepted.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy alternative: SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional public contact destination for listing enquiries requiring owner approval.
LOCKD_SUPPORT_EMAIL=

# Keep false until migration 0008 and staging verification are complete.
LOCKD_BOOKING_REQUESTS_ENABLED=false

# Server only. Never add these to public config or browser code.
LOCKD_INTELLIGENCE_URL=
LOCKD_INTELLIGENCE_SECRET=
